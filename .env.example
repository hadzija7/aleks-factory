OPENAI_API_KEY=
# Default model for agents without a per-agent model in Factory settings (/settings).
# Any model in the factory registry (e.g. gpt-5.5, claude-sonnet-5-5 + ANTHROPIC_API_KEY, gemini-3.1-pro-preview + GEMINI_API_KEY)
MOZAIK_MODEL=gpt-5.5
# Docker image used for the run_command sandbox (needs bash + coreutils)
AGENT_SANDBOX_IMAGE=node:22-bookworm
# Max executor fix rounds requested by the code reviewer before the task fails
MAX_REVIEW_ROUNDS=3
# Mozaik cloud observability (https://app.jigjoy.ai): events are streamed when MOZAIK_API_KEY is set
MOZAIK_API_KEY=
MOZAIK_PROJECT_ID=
# none (default) | content (hide prompts, code and outputs) | all
MOZAIK_REDACTION=
# Dash0 AI SDLC Insights (OpenTelemetry over OTLP/HTTP): agent sessions are traced when both are set.
# Metadata only (model, token counts, tool timings, VCS); prompts, messages and tool I/O are never sent.
# e.g. DASH0_OTLP_ENDPOINT=https://<your-dash0-otlp-http-endpoint> (/v1/traces is appended) and DASH0_AUTH_TOKEN=<your-dash0-auth-token>
DASH0_OTLP_ENDPOINT=
DASH0_AUTH_TOKEN=
# Optional: Dash0 dataset to send to (default dataset when unset)
DASH0_DATASET=
# Optional: gen_ai.harness.name reported to Dash0 (default mozaik)
DASH0_HARNESS_NAME=
# Optional: base URL of this board, used for the Kanban ticket link (dash0.gen_ai.vcs.issue.url), e.g. http://localhost:3000
FACTORY_PUBLIC_URL=
