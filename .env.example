OPENAI_API_KEY=
# Any model supported by @mozaik-ai/core (e.g. gpt-5.5, claude-sonnet-5-5 + ANTHROPIC_API_KEY)
MOZAIK_MODEL=gpt-5.5
# Folder the coding agent works in (all tool paths are confined to it). Defaults to data/workspace
AGENT_WORKSPACE=
# Docker image used for the run_command sandbox (needs bash + coreutils)
AGENT_SANDBOX_IMAGE=node:22-bookworm
